# BestDoors API – copy to apps/api/.env and fill in. Never commit the real .env.
# On Vercel: Project "bestdoors-api" → Settings → Environment Variables (same names).

# Postgres. Local: Docker (docker compose up -d). Production: Neon.
# DATABASE_URL = pooled connection (Neon host with "-pooler"), used by the app.
# DIRECT_URL   = direct connection (Neon host without "-pooler"), used by "prisma migrate".
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bestdoors
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/bestdoors

# Random secret, at least 32 characters (e.g. `openssl rand -base64 48`). Different in production!
JWT_SECRET=

# The shop's address (no slash at the end). Production: https://www.bestdoors.ie (or the Vercel URL)
WEB_URL=http://localhost:3000

# Admin user, created by the seed (`npm run db:seed`)
ADMIN_EMAIL=admin@bestdoors.ie
ADMIN_PASSWORD=

# Stripe (Dashboard → Developers → API keys). Test keys start with sk_test_, live keys with sk_live_.
STRIPE_SECRET_KEY=
# Stripe → Webhooks → endpoint https://<api domain>/api/v1/stripe/webhook → "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Resend (emails). Without it no emails are sent, the shop still works.
RESEND_API_KEY=
# Until bestdoors.ie is verified in Resend, keep the default (it only sends to the Resend account owner).
EMAIL_FROM=BestDoors <onboarding@resend.dev>
# Gets new quote requests and copies of order emails
SHOP_EMAIL=

# Vercel Blob (photos). Without it: local folder apps/api/uploads (development only; production answers 503).
BLOB_READ_WRITE_TOKEN=
# Newer Vercel Blob connections add BLOB_STORE_ID instead of the token (works only on Vercel, via OIDC).
# BLOB_STORE_ID=
