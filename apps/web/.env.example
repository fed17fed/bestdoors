# BestDoors web shop – copy to apps/web/.env.local and fill in. Never commit the real file.
# On Vercel: Project "bestdoors-web" → Settings → Environment Variables (same names).

# Where the Express API runs (no slash at the end). The shop forwards /api/* there.
# Production: the URL of the Vercel API project, e.g. https://bestdoors-api.vercel.app
API_URL=http://localhost:4000

# The public address of the shop: used for canonical links, hreflang, sitemap.xml and robots.txt.
# Production: https://www.bestdoors.ie (or the Vercel URL until the domain is ready)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
